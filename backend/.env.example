# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection (port 5432), not the transaction pooler (6543): migrations
# create extensions and build HNSW indexes, which need session-level access.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna

ALLOWED_ORIGINS=["http://localhost:5173"]
